{
  "name": "specguard",
  "version": "1.0.0",
  "description": "Detect OpenAPI breaking changes in CI before you ship",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "specguard": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openapi",
    "breaking-changes",
    "api",
    "cli",
    "typescript",
    "github-actions",
    "devops",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karguvel7/specguard.git"
  },
  "homepage": "https://karguvel7.github.io/specguard/",
  "bugs": {
    "url": "https://github.com/karguvel7/specguard/issues"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "eslint": "^9.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vitest": "^2.1.4"
  }
}
